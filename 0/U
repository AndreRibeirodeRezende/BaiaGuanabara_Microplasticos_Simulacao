FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    Fundo
    {
        type            noSlip;
    }
    Topo
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    Paredes
    {
        type            noSlip;
    }
    Fronteira_Aberta
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
}
